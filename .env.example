# =============================================================================
# The Crime & Society Review (CSR) — Environment Variables Template
# Copy this file to .env and configure your keys
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Cloudflare Turnstile Anti-Bot Security
# -----------------------------------------------------------------------------
# Development Test Site Key (Always Passes automatically): 1x00000000000000000000AA
# Replace this with your production Site Key from Cloudflare Dashboard -> Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-Side Turnstile Secret Key (Used in Cloudflare Workers / backend validation)
# Test Secret Key (Always Passes): 1x0000000000000000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------------------
# 2. Journal Website & Domain Configuration
# -----------------------------------------------------------------------------
VITE_APP_NAME="The Crime & Society Review"
VITE_APP_URL="http://localhost:3000/"
VITE_CONTACT_EMAIL="editorial@thecrimeandsocietyreview.com"

# -----------------------------------------------------------------------------
# 4. Cloudflare Infrastructure (R2 Storage & D1 Database)
# -----------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
VITE_CLOUDFLARE_R2_BUCKET_NAME=csr-manuscripts-prod
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
VITE_CLOUDFLARE_D1_DATABASE_NAME=csr-database-prod
